{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "routeMode": {
      "type": "string",
      "enum": ["disabled", "selected", "all"]
    },
    "enabledRoutes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "disabledRoutes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "telemetryDisabled": {
      "type": "boolean"
    },
    "gitCommitContextEnabled": {
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "routeMode",
    "enabledRoutes",
    "disabledRoutes",
    "telemetryDisabled",
    "gitCommitContextEnabled"
  ],
  "additionalProperties": false
}

