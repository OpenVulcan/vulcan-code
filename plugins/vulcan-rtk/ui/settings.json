        },
        {
          "type": "field",
          "key": "disabledRoutes",
          "control": "checklist",
          "label_message_key": "routes.allowed",
          "description_message_key": "routes.allHelp",
          "selection": "exclude",
          "visible_when": {
            "key": "routeMode",
            "values": [
              "all"
            ]
          },
          "option_groups": [
            {
              "id": "curated",
              "title_message_key": "routes.curated",
              "values": [
                "cargo",
                "find",
                "git",
                "go",
                "grep",
