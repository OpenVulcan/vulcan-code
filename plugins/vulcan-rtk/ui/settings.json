{
  "schema_version": 1,
  "config": {
    "read_action": "settings-get",
    "write_action": "settings-update"
  },
  "header": {
    "status": {
      "ready_message_key": "availability.ready",
      "unavailable_message_key": "availability.unavailable"
    },
    "links": [
      {
        "url": "https://github.com/rtk-ai/rtk",
        "label_message_key": "compliance.repositoryTag",
        "aria_label_message_key": "compliance.githubAria",
        "icon": "github"
      }
    ],
    "documents": [
      {
        "id": "license",
        "asset": "LICENSE",
        "label_message_key": "compliance.licenseTag",
        "aria_label_message_key": "compliance.licenseAria",
        "title_message_key": "compliance.licenseTitle",
        "description_message_key": "compliance.licenseDescription",
        "icon": "license"
      }
    ]
  },
  "tabs": [
    {
      "id": "settings",
      "title_message_key": "sections.settings",
      "sections": [
        "general"
      ]
    },
    {
      "id": "routes",
      "title_message_key": "sections.routes",
      "sections": [
        "routes"
      ]
    },
    {
      "id": "statistics",
      "title_message_key": "sections.statistics",
      "sections": [
        "gain"
      ]
    }
  ],
  "sections": [
    {
      "id": "general",
      "title_message_key": "sections.settings",
      "items": [
        {
          "type": "field",
          "key": "enabled",
          "control": "switch",
          "label_message_key": "enableRouting",
          "description_message_key": "enableRoutingHelp"
        },
        {
          "type": "field",
          "key": "gitCommitContextEnabled",
          "control": "switch",
          "label_message_key": "gitContext",
          "description_message_key": "gitContextHelp"
        },
        {
          "type": "field",
          "key": "telemetryDisabled",
          "control": "switch",
          "label_message_key": "disableTelemetry",
          "description_message_key": "disableTelemetryHelp"
        }
      ],
      "layout": "inline"
    },
    {
      "id": "routes",
      "title_message_key": "routes.title",
      "description_message_key": "routes.description",
      "items": [
        {
          "type": "field",
          "key": "routeMode",
          "control": "select",
          "label_message_key": "routeMode.label",
          "description_message_key": "routeMode.help",
          "options": [
            {
              "value": "disabled",
              "label_message_key": "routeMode.disabled"
            },
            {
              "value": "selected",
              "label_message_key": "routeMode.selected"
            },
            {
              "value": "all",
              "label_message_key": "routeMode.all"
            }
          ]
        },
        {
          "type": "field",
          "key": "enabledRoutes",
          "control": "checklist",
          "label_message_key": "routes.allowed",
          "description_message_key": "routes.selectedHelp",
          "selection": "include",
          "visible_when": {
            "key": "routeMode",
            "values": [
              "selected"
            ]
          },
          "option_groups": [
            {
              "id": "curated",
              "title_message_key": "routes.curated",
              "values": [
                "cargo",
