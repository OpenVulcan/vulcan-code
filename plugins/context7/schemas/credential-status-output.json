{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "configured": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["anonymous", "api_key"] },
    "credentialGeneration": { "type": "integer", "minimum": 0 },
    "updatedAtMs": { "type": "integer", "minimum": 0 },
    "validationStatus": { "type": "string", "enum": ["unknown", "untested", "valid", "invalid"] },
    "validatedAtMs": { "type": ["integer", "null"], "minimum": 0 }
  },
  "required": ["configured", "mode", "credentialGeneration", "updatedAtMs", "validationStatus"],
  "additionalProperties": false
}
