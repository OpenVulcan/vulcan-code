{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connected": { "const": true },
    "mode": { "type": "string", "enum": ["anonymous", "api_key"] },
    "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
    "quotaTier": { "type": ["string", "null"] },
    "quotaLimit": { "type": ["integer", "null"], "minimum": 0 },
    "quotaRemaining": { "type": ["integer", "null"], "minimum": 0 },
    "quotaResetUnixSec": { "type": ["integer", "null"], "minimum": 0 }
  },
  "required": ["connected", "mode", "httpStatus"],
  "additionalProperties": false
}
