{
  "schema_version": 1,
  "config": {
    "read_action": "settings-get",
    "write_action": "settings-update"
  },
  "sections": [
    {
      "id": "authentication",
      "title_message_key": "credentialTitle",
      "description_message_key": "allowanceDescription",
      "items": [
        {
          "type": "credential",
          "id": "api-key",
          "label_message_key": "apiKeyLabel",
          "placeholder_message_key": "apiKeyPlaceholder",
          "status_action": "credential-status",
          "set_action": "credential-set",
          "set_argument": "apiKey",
          "delete_action": "credential-delete"
        },
        {
          "type": "action",
          "id": "connection-test",
          "action": "connection-test",
          "label_message_key": "connectionTest",
          "description_message_key": "connectionTestHint",
          "success_message_key": "connectionSuccess"
        }
      ],
      "links": [
        {
          "url": "https://context7.com/docs/howto/api-keys",
          "label_message_key": "apiKeyDocsLink"
        },
        {
          "url": "https://context7.com/dashboard",
          "label_message_key": "dashboardLink"
        }
      ]
    },
    {
      "id": "behavior",
      "title_message_key": "behaviorTitle",
      "items": [
        {
          "type": "field",
          "key": "defaultFastMode",
          "control": "switch",
          "label_message_key": "defaultFastMode",
          "description_message_key": "defaultFastModeHint"
        },
        {
          "type": "field",
          "key": "requestTimeoutMs",
          "control": "select",
          "label_message_key": "timeout",
          "description_message_key": "timeoutHint",
          "value_format": "duration_ms",
          "options": [
            {
              "value": 10000
            },
            {
              "value": 30000
            },
            {
              "value": 60000
            }
          ]
        },
        {
          "type": "field",
          "key": "retentionDays",
          "control": "select",
          "label_message_key": "retention",
          "description_message_key": "retentionHint",
          "value_format": "days",
          "options": [
            {
              "value": 30
            },
            {
              "value": 90
            },
            {
              "value": 180
            },
            {
              "value": 365
            }
          ]
        }
      ]
    },
    {
      "id": "usage",
      "title_message_key": "usageTitle",
      "links": [
        {
          "url": "https://context7.com/dashboard",
          "label_message_key": "dashboardLink"
        },
        {
          "url": "https://context7.com/docs/howto/usage",
          "label_message_key": "usageDocsLink"
        }
      ],
      "data": {
        "action": "usage-get",
        "refreshable": true,
        "refresh_topics": [
          "context7.data"
        ],
        "arguments": [
          {
            "name": "rangeDays",
            "label_message_key": "usageRange",
            "value_format": "days",
            "default": 30,
            "options": [
              {
                "value": 7
              },
              {
                "value": 30
              },
              {
                "value": 90
              },
              {
                "value": 365
              }
            ]
          }
        ]
      },
      "blocks": [
        {
          "type": "metrics",
          "title_message_key": "localStatsTitle",
          "help_message_key": "localUsageNotice",
          "items": [
            {
              "label_message_key": "requests",
              "path": "localStats.requests",
              "format": "number"
            },
            {
              "label_message_key": "successes",
              "path": "localStats.successes",
              "format": "number"
            },
            {
              "label_message_key": "failures",
              "path": "localStats.failures",
              "format": "number"
            },
            {
              "label_message_key": "averageDuration",
              "path": "localStats.averageDurationMs",
              "format": "duration_ms"
            }
          ]
        },
        {
          "type": "metrics",
          "title_message_key": "quotaTitle",
          "help_message_key": "officialUsageNotice",
          "source_path": "quotaSnapshot",
          "empty_message_key": "noQuota",
          "items": [
            {
              "label_message_key": "quotaTier",
              "path": "quotaTier",
              "format": "text"
            },
            {
              "label_message_key": "quotaRemaining",
              "path": "quotaRemaining",
              "format": "number"
            },
            {
              "label_message_key": "quotaLimit",
              "path": "quotaLimit",
              "format": "number"
            },
            {
              "label_message_key": "quotaReset",
              "path": "quotaResetUnixSec",
              "format": "date_unix_sec"
            }
          ]
        }
      ]
    }
  ]
}
