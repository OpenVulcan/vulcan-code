{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "retentionDays": { "type": "integer", "enum": [0, 30, 90, 180, 365] },
    "defaultRangeDays": { "type": "integer", "enum": [0, 7, 30, 90, 365] },
    "defaultMetric": {
      "type": "string",
      "enum": ["total_tokens", "input_tokens", "output_tokens", "requests", "duration_ms", "time_to_first_token_ms"]
    }
  },
  "required": ["enabled", "retentionDays", "defaultRangeDays", "defaultMetric"],
  "additionalProperties": false
}
