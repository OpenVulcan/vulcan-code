{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modelOverrides": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "$ref": "#/$defs/modelPrice"
      }
    }
  },
  "required": ["modelOverrides"],
  "additionalProperties": false,
  "$defs": {
    "decimalPrice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "modelPrice": {
      "type": "object",
      "properties": {
        "inputPerMillion": { "$ref": "#/$defs/decimalPrice" },
        "outputPerMillion": { "$ref": "#/$defs/decimalPrice" },
        "cacheReadPerMillion": { "$ref": "#/$defs/decimalPrice" },
        "cacheWritePerMillion": { "$ref": "#/$defs/decimalPrice" }
      },
      "required": [
        "inputPerMillion",
        "outputPerMillion",
        "cacheReadPerMillion",
        "cacheWritePerMillion"
      ],
      "additionalProperties": false
    }
  }
}
