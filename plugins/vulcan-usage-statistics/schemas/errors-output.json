{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "errorCategory": { "type": "string", "minLength": 1 },
          "errorCode": { "type": "string" },
          "count": { "type": "number", "minimum": 1 }
        },
        "required": ["errorCategory", "errorCode", "count"],
        "additionalProperties": false
      }
    }
  },
  "required": ["errors"],
  "additionalProperties": false
}
