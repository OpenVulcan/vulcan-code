{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "totalCount": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "minLength": 1 },
    "providerIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "models": {
      "type": "array", "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "modelId": { "type": "string" },
          "attempts": { "type": "integer", "minimum": 0 },
          "source": { "enum": ["catalog", "override", "provider_override", "unpriced", "conflict"] },
          "aliases": { "type": "array", "maxItems": 25, "items": { "type": "string" } },
          "effectivePrices": { "$ref": "#/$defs/currencyPrices" },
          "offPeakPrices": { "$ref": "#/$defs/currencyPrices" },
          "nativeUnitRates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "unit": {
                  "enum": ["input_second", "input_10000_characters", "input_image", "output_image", "output_image_1k", "output_image_2k", "output_second_480p", "output_second_720p", "output_second_1080p"]
                },
                "beijingCny": { "type": "string" },
                "singaporeCny": { "type": "string" }
              },
              "required": ["unit", "beijingCny", "singaporeCny"],
              "additionalProperties": false
            }
          }
        },
        "required": ["modelId", "attempts", "source", "aliases", "effectivePrices"],
        "additionalProperties": false
      }
    }
  },
  "required": ["totalCount", "currency", "models"],
  "additionalProperties": false,
  "$defs": {
    "currencyPrices": {
      "type": "object",
      "properties": {
        "USD": { "$ref": "#/$defs/prices" },
        "CNY": { "$ref": "#/$defs/prices" }
      },
      "additionalProperties": false
    },
    "prices": {
      "type": "object",
      "properties": {
        "inputPerMillion": { "type": "string" },
        "outputPerMillion": { "type": "string" },
        "cacheReadPerMillion": { "type": "string" },
        "cacheWritePerMillion": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
