{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": ["string", "null"] },
    "workspace_id": { "type": "string", "minLength": 1 },
    "owner_kind": { "enum": ["main_agent", "subagent", "context_compaction", "git_commit_summary", "internal_llm", "internal_embedding", "internal_rerank", "internal_multimodal"] },
    "owner_id": { "type": "string", "minLength": 1 },
    "owner_name": { "type": "string", "minLength": 1 },
    "usage_scope": { "enum": ["interactive_agent", "internal_background", "external_service"] },
    "provider_key": { "type": "string", "minLength": 1 },
    "provider_name": { "type": "string", "minLength": 1 },
    "service_entry_id": { "type": "string", "minLength": 1 },
    "connection_id": { "type": "string", "minLength": 1 },
    "protocol_profile_id": { "type": "string", "minLength": 1 },
    "secondary_route_id": { "type": ["string", "null"] },
    "secondary_provider_name": { "type": ["string", "null"] },
    "secondary_endpoint_name": { "type": ["string", "null"] },
    "model_key": { "type": "string", "minLength": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "capability_revision": { "type": "string", "minLength": 1 },
    "catalog_revision": { "type": "string", "minLength": 1 },
    "input_item_count": { "type": "integer", "minimum": 0 },
    "output_item_count": { "type": "integer", "minimum": 0 },
    "vector_dimensions": { "type": "integer", "minimum": 1 },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "calendar_date": { "type": "string", "format": "date" },
    "timezone_offset_minutes": { "type": "integer", "minimum": -1440, "maximum": 1440 },
    "retry_number": { "type": "integer", "minimum": 1 },
    "max_retries": { "type": "integer", "minimum": 0 },
    "delay_ms": { "type": "integer", "minimum": 0 },
    "error_category": { "type": "string", "minLength": 1 },
    "retrying_at_ms": { "type": "integer" }
  },
  "required": ["schema_version", "request_id", "execution_id", "session_id", "retry_number", "max_retries", "delay_ms", "error_category", "retrying_at_ms"],
  "additionalProperties": false
}
