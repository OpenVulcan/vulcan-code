{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": ["string", "null"] },
    "workspace_id": { "type": "string", "minLength": 1 },
    "owner_kind": { "enum": ["main_agent", "subagent", "context_compaction", "git_commit_summary"] },
    "owner_id": { "type": "string", "minLength": 1 },
    "owner_name": { "type": "string", "minLength": 1 },
    "provider_key": { "type": "string", "minLength": 1 },
    "provider_name": { "type": "string", "minLength": 1 },
    "model_key": { "type": "string", "minLength": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["succeeded", "failed", "cancelled"] },
    "started_at_ms": { "type": "integer" },
    "first_event_at_ms": { "type": ["integer", "null"] },
    "first_token_at_ms": { "type": ["integer", "null"] },
    "completed_at_ms": { "type": "integer" },
    "time_to_first_event_ms": { "type": ["integer", "null"], "minimum": 0 },
    "time_to_first_token_ms": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "uncached_input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cache_creation_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "finish_reason": { "type": ["string", "null"] },
    "error_category": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "calendar_date": { "type": "string", "format": "date" },
    "timezone_offset_minutes": { "type": "integer", "minimum": -1440, "maximum": 1440 }
  },
  "required": ["schema_version", "request_id", "execution_id", "session_id", "project_id", "workspace_id", "owner_kind", "owner_id", "owner_name", "provider_key", "provider_name", "model_key", "model_name", "attempt_index", "retry_count", "status", "started_at_ms", "first_event_at_ms", "first_token_at_ms", "completed_at_ms", "time_to_first_event_ms", "time_to_first_token_ms", "duration_ms", "input_tokens", "uncached_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens", "cached_input_tokens", "cache_creation_input_tokens", "finish_reason", "error_category", "error_code", "calendar_date", "timezone_offset_minutes"],
  "additionalProperties": false
}
