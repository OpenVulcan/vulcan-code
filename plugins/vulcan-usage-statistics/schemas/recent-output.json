{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "completedAtMs": { "type": "number" },
          "providerName": { "type": "string", "minLength": 1 },
          "modelName": { "type": "string", "minLength": 1 },
          "ownerKind": { "enum": ["main_agent", "subagent", "context_compaction", "git_commit_summary", "internal_llm", "internal_embedding", "internal_rerank", "internal_multimodal"] },
          "ownerName": { "type": "string", "minLength": 1 },
          "status": { "enum": ["succeeded", "failed", "cancelled"] },
          "inputTokens": { "type": "number", "minimum": 0 },
          "outputTokens": { "type": "number", "minimum": 0 },
          "totalTokens": { "type": ["number", "null"], "minimum": 0 },
          "providerTotalTokens": { "type": ["number", "null"], "minimum": 0 },
          "totalTokenSource": { "enum": ["reported", "derived", "inconsistent", "unknown"] },
          "cachedInputTokens": { "type": ["number", "null"], "minimum": 0 },
          "timeToFirstTokenMs": { "type": ["number", "null"], "minimum": 0 },
          "durationMs": { "type": "number", "minimum": 0 },
          "retryCount": { "type": "number", "minimum": 0 },
          "errorCategory": { "type": ["string", "null"] },
          "errorCode": { "type": ["string", "null"] }
        },
        "required": ["requestId", "completedAtMs", "providerName", "modelName", "ownerKind", "ownerName", "status", "inputTokens", "outputTokens", "totalTokens", "providerTotalTokens", "totalTokenSource", "durationMs", "retryCount"],
        "additionalProperties": false
      }
    }
  },
  "required": ["requests"],
  "additionalProperties": false
}
