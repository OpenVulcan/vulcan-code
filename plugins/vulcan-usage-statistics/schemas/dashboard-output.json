{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAtMs": { "type": "integer" },
    "schemaRevision": { "type": "integer", "minimum": 0 },
    "aggregateRevision": { "type": "integer", "minimum": 0 },
    "healthStatus": { "type": "string", "minLength": 1 },
    "pricingCatalog": { "$ref": "#/$defs/pricingCatalog" },
    "daily": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/dailySummary" }
    },
    "heatmap": {
      "type": "array",
      "items": { "$ref": "#/$defs/heatmapCell" }
    },
    "series": {
      "type": "array",
      "items": { "$ref": "#/$defs/seriesPoint" }
    },
    "recentAttempts": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/attemptSummary" }
    },
    "accounts": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/accountSummary" }
    }
  },
  "required": [
    "generatedAtMs",
    "schemaRevision",
    "aggregateRevision",
    "healthStatus",
    "pricingCatalog",
    "daily",
    "heatmap",
    "series",
    "recentAttempts",
    "accounts"
  ],
  "additionalProperties": false,
  "$defs": {
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "pricingMatchStatus": {
      "type": "string",
      "enum": ["catalog_exact", "override_exact", "unmatched", "incomplete_usage"]
    },
    "pricingCatalog": {
      "type": "object",
      "properties": {
        "catalogId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "entryCount": { "type": "integer", "minimum": 0 },
        "overrideCount": { "type": "integer", "minimum": 0 },
        "matchingStrategy": {
          "type": "string",
          "const": "exact_canonical_model_id"
        }
      },
      "required": ["catalogId", "revision", "currency", "entryCount", "overrideCount", "matchingStrategy"],
      "additionalProperties": false
    },
    "dailySummary": {
      "type": "object",
      "properties": {
        "calendarDate": { "type": "string", "format": "date" },
        "providerId": { "type": "string", "minLength": 1 },
        "serviceEntryId": { "type": "string", "minLength": 1 },
        "consumerId": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "attemptCount": { "type": "integer", "minimum": 0 },
        "successfulAttemptCount": { "type": "integer", "minimum": 0 },
        "reportedUsageAttemptCount": { "type": "integer", "minimum": 0 },
        "inputTokens": { "$ref": "#/$defs/nullableInteger" },
        "uncachedInputTokens": { "$ref": "#/$defs/nullableInteger" },
        "cacheReadTokens": { "$ref": "#/$defs/nullableInteger" },
        "cacheWriteTokens": { "$ref": "#/$defs/nullableInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoningTokens": { "$ref": "#/$defs/nullableInteger" },
        "totalTokens": { "$ref": "#/$defs/nullableInteger" },
        "estimatedCost": { "$ref": "#/$defs/nullableString" },
        "estimatedCurrency": { "$ref": "#/$defs/nullableString" },
        "pricingMatchStatus": { "$ref": "#/$defs/pricingMatchStatus" },
        "pricingRevision": { "$ref": "#/$defs/nullableString" },
        "pricingSourceId": { "$ref": "#/$defs/nullableString" },
        "aggregateRevision": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "calendarDate",
        "providerId",
        "serviceEntryId",
        "consumerId",
        "operation",
        "modelId",
        "attemptCount",
        "successfulAttemptCount",
        "reportedUsageAttemptCount",
        "inputTokens",
        "uncachedInputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "outputTokens",
        "reasoningTokens",
        "totalTokens",
        "estimatedCost",
        "estimatedCurrency",
        "pricingMatchStatus",
        "pricingRevision",
        "pricingSourceId",
        "aggregateRevision"
      ],
      "additionalProperties": false
    },
    "heatmapCell": {
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "value": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "successes": { "type": "integer", "minimum": 0 },
        "topProviderName": { "$ref": "#/$defs/nullableString" },
        "topModelName": { "$ref": "#/$defs/nullableString" }
      },
      "required": ["date", "value", "requests", "successes", "topProviderName", "topModelName"],
      "additionalProperties": false
    },
    "seriesPoint": {
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "seriesKey": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0 }
      },
      "required": ["date", "seriesKey", "label", "value"],
      "additionalProperties": false
    },
    "billingDetail": {
      "type": "object",
      "properties": {
        "billing_type": { "type": "string", "minLength": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "text_tokens": { "type": "integer", "minimum": 0 },
        "image_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["billing_type"],
      "additionalProperties": false
    },
    "attemptSummary": {
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "minLength": 1 },
        "consumerId": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "serviceEntryId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "transport": { "$ref": "#/$defs/nullableString" },
        "httpStatus": { "$ref": "#/$defs/nullableInteger" },
        "websocketCloseCode": { "$ref": "#/$defs/nullableInteger" },
        "errorCategory": { "$ref": "#/$defs/nullableString" },
        "errorCode": { "$ref": "#/$defs/nullableString" },
        "status": { "type": "string", "minLength": 1 },
        "usageAvailability": { "type": "string", "minLength": 1 },
        "inputTokens": { "$ref": "#/$defs/nullableInteger" },
        "uncachedInputTokens": { "$ref": "#/$defs/nullableInteger" },
        "cacheReadTokens": { "$ref": "#/$defs/nullableInteger" },
        "cacheWriteTokens": { "$ref": "#/$defs/nullableInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoningTokens": { "$ref": "#/$defs/nullableInteger" },
        "audioInputTokens": { "$ref": "#/$defs/nullableInteger" },
        "audioOutputTokens": { "$ref": "#/$defs/nullableInteger" },
        "totalTokens": { "$ref": "#/$defs/nullableInteger" },
        "billingDetails": {
          "type": "array",
          "items": { "$ref": "#/$defs/billingDetail" }
        },
        "estimatedCost": { "$ref": "#/$defs/nullableString" },
        "estimatedCurrency": { "$ref": "#/$defs/nullableString" },
        "pricingMatchStatus": { "$ref": "#/$defs/pricingMatchStatus" },
        "pricingRevision": { "$ref": "#/$defs/nullableString" },
        "pricingSourceId": { "$ref": "#/$defs/nullableString" },
        "terminalAtMs": { "type": "integer" }
      },
      "required": [
        "attemptId",
        "consumerId",
        "operation",
        "providerId",
        "serviceEntryId",
        "modelId",
        "transport",
        "httpStatus",
        "websocketCloseCode",
        "errorCategory",
        "errorCode",
        "status",
        "usageAvailability",
        "inputTokens",
        "uncachedInputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "outputTokens",
        "reasoningTokens",
        "audioInputTokens",
        "audioOutputTokens",
        "totalTokens",
        "billingDetails",
        "estimatedCost",
        "estimatedCurrency",
        "pricingMatchStatus",
        "pricingRevision",
        "pricingSourceId",
        "terminalAtMs"
      ],
      "additionalProperties": false
    },
    "accountSummary": {
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "connectionId": { "type": "string", "minLength": 1 },
        "snapshotKind": { "type": "string", "minLength": 1 },
        "endpointProfileRevision": { "type": "string", "minLength": 1 },
        "payload": {},
        "observedAtMs": { "type": "integer" }
      },
      "required": [
        "providerId",
        "connectionId",
        "snapshotKind",
        "endpointProfileRevision",
        "payload",
        "observedAtMs"
      ],
      "additionalProperties": false
    }
  }
}
