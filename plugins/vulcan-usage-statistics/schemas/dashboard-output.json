{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": { "type": "integer", "minimum": 0 },
    "rangeDays": { "type": "integer", "enum": [0, 7, 30, 90, 365] },
    "metric": {
      "type": "string",
      "enum": ["total_tokens", "input_tokens", "output_tokens", "requests", "duration_ms", "time_to_first_token_ms"]
    },
    "summary": {
      "type": "object",
      "properties": {
        "requests": { "type": "number", "minimum": 0 },
        "successes": { "type": "number", "minimum": 0 },
        "failures": { "type": "number", "minimum": 0 },
        "cancelled": { "type": "number", "minimum": 0 },
        "retries": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": "number", "minimum": 0 },
        "outputTokens": { "type": "number", "minimum": 0 },
        "reasoningTokens": { "type": "number", "minimum": 0 },
        "totalTokens": { "type": "number", "minimum": 0 },
        "cachedInputTokens": { "type": "number", "minimum": 0 },
        "cacheCreationInputTokens": { "type": "number", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 },
        "averageDurationMs": { "type": "number", "minimum": 0 },
        "mainAgentTokens": { "type": "number", "minimum": 0 },
        "subagentTokens": { "type": "number", "minimum": 0 },
        "internalTokens": { "type": "number", "minimum": 0 },
        "longestRequestMs": { "type": "number", "minimum": 0 },
        "peakRequestTokens": { "type": "number", "minimum": 0 },
        "averageFirstTokenMs": { "type": "number", "minimum": 0 },
        "activeDays": { "type": "number", "minimum": 0 },
        "currentStreakDays": { "type": "number", "minimum": 0 },
        "longestStreakDays": { "type": "number", "minimum": 0 },
        "peakDailyTokens": { "type": "number", "minimum": 0 },
        "successRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "cacheHitRate": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["requests", "successes", "failures", "cancelled", "retries", "inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "cachedInputTokens", "cacheCreationInputTokens", "durationMs", "averageDurationMs", "mainAgentTokens", "subagentTokens", "internalTokens", "longestRequestMs", "peakRequestTokens", "averageFirstTokenMs", "activeDays", "currentStreakDays", "longestStreakDays", "peakDailyTokens", "successRate", "cacheHitRate"],
      "additionalProperties": false
    },
    "heatmap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "value": { "type": "number", "minimum": 0 },
          "requests": { "type": "number", "minimum": 0 },
          "successes": { "type": "number", "minimum": 0 },
          "topProviderName": { "type": ["string", "null"] },
          "topModelName": { "type": ["string", "null"] }
        },
        "required": ["date", "value", "requests", "successes", "topProviderName", "topModelName"],
        "additionalProperties": false
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "seriesRef": { "type": "number", "minimum": 0 },
          "seriesKey": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "number", "minimum": 0 }
        },
        "required": ["date", "seriesRef", "seriesKey", "label", "value"],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelRef": { "type": "number", "minimum": 1 },
          "providerKey": { "type": "string", "minLength": 1 },
          "providerName": { "type": "string", "minLength": 1 },
          "modelKey": { "type": "string", "minLength": 1 },
          "modelName": { "type": "string", "minLength": 1 },
          "totalTokens": { "type": "number", "minimum": 0 },
          "requests": { "type": "number", "minimum": 0 },
          "sharePercent": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["modelRef", "providerKey", "providerName", "modelKey", "modelName", "totalTokens", "requests", "sharePercent"],
        "additionalProperties": false
      }
    }
  },
  "required": ["revision", "rangeDays", "metric", "summary", "heatmap", "series", "models"],
  "additionalProperties": false
}
