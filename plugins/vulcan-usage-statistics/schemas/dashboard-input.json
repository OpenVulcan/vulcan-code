{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rangeDays": { "type": "integer", "enum": [0, 7, 30, 90, 365] },
    "metric": {
      "type": "string",
      "enum": ["total_tokens", "input_tokens", "output_tokens", "requests", "duration_ms", "time_to_first_token_ms"]
    },
    "ownerKind": {
      "type": "string",
      "enum": ["main_agent", "subagent", "context_compaction", "git_commit_summary"]
    }
  },
  "required": ["rangeDays", "metric"],
  "additionalProperties": false
}
