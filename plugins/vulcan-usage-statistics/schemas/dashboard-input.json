{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "view": { "enum": ["all", "overview", "details", "providers", "recent", "maintenance", "daily-page", "recent-page", "detail-pages"] },
    "rangeDays": { "type": "integer", "enum": [7, 30, 90, 365] },
    "consumerId": { "type": "string", "maxLength": 256 },
    "providerId": { "type": "string", "maxLength": 256 },
    "modelQuery": { "type": "string", "maxLength": 256 },
    "sortOrder": { "type": "string", "enum": ["newest", "oldest"] },
    "dailyOffset": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "recentOffset": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "recentModelType": { "type": "string", "enum": ["all", "llm", "embedding", "rerank", "decision"] },
    "startAtMs": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 },
    "endAtMs": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 }
  },
  "dependentRequired": { "startAtMs": ["endAtMs"], "endAtMs": ["startAtMs"] },
  "additionalProperties": false
}
