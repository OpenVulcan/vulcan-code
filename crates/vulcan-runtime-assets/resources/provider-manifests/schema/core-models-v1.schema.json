{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vulcan.core-models.v1",
  "title": "Vulcan Core Model List v1",
  "description": "Model-level facts provider rules inherit through core_model_ref. Route facts (protocol, structured output, prompt cache, native tools, parameters) stay in provider manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "published_at", "models", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "vulcan.core-models.v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "published_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "display_name", "vendor", "capabilities", "verification"],
        "properties": {
          "model_id": { "$ref": "#/$defs/model_identifier" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "vendor": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "aliases": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/model_alias" }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operations": { "type": "array", "items": { "type": "string" } },
              "input_resources": { "type": "array", "items": { "type": "string" } },
              "output_resources": { "type": "array", "items": { "type": "string" } },
              "reasoning": { "type": "string" },
              "reasoning_control": { "type": "string" },
              "reasoning_efforts": { "type": "array", "items": { "type": "string" } },
              "context_limit": { "type": "integer", "minimum": 1 },
              "output_limit": { "type": "integer", "minimum": 1 },
              "embedding": { "type": "object" },
              "rerank": { "type": "object" }
            }
          },
          "verification": { "enum": ["verified", "seeded"] },
          "provenance_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["example_only", "verified", "migrated"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "note": { "type": "string" }
            }
          }
        },
        "verified_at": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    }
  },
  "$defs": {
    "model_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "model_alias": {
      "description": "Normalized lookup spelling: trimmed and lowercase; display spellings such as `vendor: name` are allowed.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\sA-Z](.*[^\\sA-Z])?$"
    }
  }
}
