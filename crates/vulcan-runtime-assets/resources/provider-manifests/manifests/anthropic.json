  "usage_profiles": [],
  "request_profiles": [
    {
      "profile_id": "anthropic.adaptive-effort.v1",
      "description": "Adaptive thinking with summarized display and exact effort for models whose thinking is off by default",
      "payload": {
        "profile_id": "anthropic.adaptive-effort.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "low": {
                "type": "adaptive",
                "display": "summarized"
              },
              "medium": {
                "type": "adaptive",
                "display": "summarized"
              },
              "high": {
                "type": "adaptive",
                "display": "summarized"
              },
              "xhigh": {
                "type": "adaptive",
                "display": "summarized"
              },
              "max": {
                "type": "adaptive",
                "display": "summarized"
              }
            },
            "unmatched": "error",
            "default": null
          },
          {
            "op": "copy_request_field",
            "path": "/output_config/effort",
            "field": "reasoning_effort"
          },
          {
            "op": "delete_if_equals",
            "path": "/output_config/effort",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "equals": "none"
          },
          {
            "op": "remove_if_empty",
            "path": "/output_config"
          }
        ]
      }
    },
    {
      "profile_id": "anthropic.default-adaptive-effort.v1",
      "description": "Adaptive thinking with summarized display and exact effort for models whose adaptive thinking is on by default",
      "payload": {
        "profile_id": "anthropic.default-adaptive-effort.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "low": {
                "type": "adaptive",
                "display": "summarized"
              },
              "medium": {
                "type": "adaptive",
                "display": "summarized"
              },
              "high": {
                "type": "adaptive",
                "display": "summarized"
              },
              "xhigh": {
                "type": "adaptive",
                "display": "summarized"
              },
              "max": {
                "type": "adaptive",
                "display": "summarized"
              }
            },
            "unmatched": "error",
            "default": {
              "type": "adaptive",
              "display": "summarized"
            }
          },
          {
            "op": "copy_request_field",
            "path": "/output_config/effort",
            "field": "reasoning_effort"
          },
          {
            "op": "delete_if_equals",
            "path": "/output_config/effort",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "equals": "none"
          },
          {
            "op": "remove_if_empty",
            "path": "/output_config"
          }
        ]
      }
    }
  ],
