  "request_profiles": [
    {
      "profile_id": "xiaomi.chat.thinking.v1",
      "description": "Project the reasoning toggle to the MiMo Chat thinking object.",
      "payload": {
        "profile_id": "xiaomi.chat.thinking.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "high": {
                "type": "enabled"
              }
            },
            "unmatched": "error",
            "default": null
          },
          {
            "op": "delete_json_pointer",
            "path": "/reasoning_effort"
          },
          {
            "op": "delete_unless_equals",
            "path": "/temperature",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "equals": "none"
          },
          {
            "op": "delete_unless_equals",
            "path": "/top_p",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "equals": "none"
          }
        ]
      }
    },
    {
      "profile_id": "xiaomi.asr.request.v1",
      "description": "Build the documented single-audio MiMo transcription request.",
      "payload": {
        "profile_id": "xiaomi.asr.request.v1",
        "revision": 1,
        "steps": [
          {
            "op": "rebuild_json_template",
            "template": {
              "model": {
                "$vulcan_model_id": true
              },
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "type": "input_audio",
                      "input_audio": {
                        "data": {
                          "$vulcan_ref": {
                            "path": "/audio_data"
                          }
                        }
                      }
                    }
                  ]
                }
              ],
              "asr_options": {
                "language": {
                  "$vulcan_ref": {
                    "path": "/language",
                    "optional": true
                  }
                }
              },
              "stream": false
            }
          }
        ]
      }
    },
    {
      "profile_id": "xiaomi.tts.request.v1",
      "description": "Synthesize the assistant message with an optional preset voice.",
      "payload": {
        "profile_id": "xiaomi.tts.request.v1",
        "revision": 1,
        "steps": [
          {
            "op": "rebuild_json_template",
            "template": {
              "model": {
                "$vulcan_model_id": true
              },
              "messages": [
                {
                  "role": "assistant",
                  "content": {
                    "$vulcan_ref": {
                      "path": "/text"
                    }
                  }
                }
              ],
              "audio": {
                "format": "wav",
                "voice": {
                  "$vulcan_ref": {
                    "path": "/voice_id",
                    "optional": true
                  }
                }
              },
              "stream": false
            }
          }
        ]
      }
    },
    {
      "profile_id": "xiaomi.voice-design.request.v1",
      "description": "Use the user message to design the voice and the assistant message as the text to synthesize.",
      "payload": {
        "profile_id": "xiaomi.voice-design.request.v1",
        "revision": 1,
        "steps": [
          {
            "op": "rebuild_json_template",
            "template": {
              "model": {
                "$vulcan_model_id": true
              },
              "messages": [
                {
                  "role": "user",
                  "content": {
                    "$vulcan_ref": {
                      "path": "/voice_description"
                    }
                  }
                },
                {
                  "role": "assistant",
                  "content": {
                    "$vulcan_ref": {
                      "path": "/text"
                    }
                  }
                }
              ],
              "audio": {
                "format": "wav"
              },
              "stream": false
            }
          }
        ]
      }
    },
    {
      "profile_id": "xiaomi.voice-clone.request.v1",
      "description": "Synthesize the assistant message using the uploaded voice sample.",
      "payload": {
        "profile_id": "xiaomi.voice-clone.request.v1",
        "revision": 1,
        "steps": [
          {
            "op": "rebuild_json_template",
            "template": {
              "model": {
                "$vulcan_model_id": true
              },
              "messages": [
                {
                  "role": "assistant",
                  "content": {
                    "$vulcan_ref": {
                      "path": "/text"
                    }
                  }
                }
              ],
              "audio": {
                "format": "wav",
                "voice": {
                  "$vulcan_ref": {
                    "path": "/voice_data"
                  }
                }
              },
              "stream": false
            }
          }
        ]
      }
