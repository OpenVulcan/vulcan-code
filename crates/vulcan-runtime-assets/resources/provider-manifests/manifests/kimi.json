      "profile_id": "kimi.video-understanding.request.v1",
      "description": "Build the reviewed Kimi OpenAI-compatible streaming video-understanding request.",
      "payload": {
        "profile_id": "kimi.video-understanding.request.v1",
        "revision": 1,
        "steps": [
          {
            "op": "rebuild_json_template",
            "template": {
              "model": {
                "$vulcan_model_id": true
              },
              "stream": true,
              "messages": [
                {
                  "role": "user",
                  "content": [
