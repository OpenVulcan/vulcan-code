                        "$vulcan_ref": {
                          "path": "/prompt"
                        }
                      }
                    },
                    {
                      "type": "video_url",
                      "video_url": {
                        "url": {
                          "$vulcan_ref": {
                            "path": "/video_reference"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
