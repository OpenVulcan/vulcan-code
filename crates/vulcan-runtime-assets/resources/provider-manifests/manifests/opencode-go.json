  "request_profiles": [
    {
      "profile_id": "opencode-go.anthropic.adaptive-effort.v1",
      "description": "OpenCode v2 Anthropic adaptive thinking and exact effort variants",
      "payload": {
        "profile_id": "opencode-go.anthropic.adaptive-effort.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "low": {
                "type": "adaptive",
                "display": "summarized"
              },
              "medium": {
                "type": "adaptive",
                "display": "summarized"
              },
              "high": {
                "type": "adaptive",
                "display": "summarized"
              },
              "xhigh": {
                "type": "adaptive",
                "display": "summarized"
              },
              "max": {
                "type": "adaptive",
                "display": "summarized"
              }
            },
            "unmatched": "error",
            "default": null
          },
          {
            "op": "copy_request_field",
            "path": "/output_config/effort",
            "field": "reasoning_effort"
          },
          {
            "op": "delete_if_equals",
            "path": "/output_config/effort",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "equals": "none"
          },
          {
            "op": "remove_if_empty",
            "path": "/output_config"
          }
        ]
      }
    },
    {
      "profile_id": "opencode-go.anthropic.toggle.v1",
      "description": "OpenCode v2 Anthropic disabled and adaptive thinking variants",
      "payload": {
        "profile_id": "opencode-go.anthropic.toggle.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "adaptive": {
                "type": "adaptive",
                "display": "summarized"
              }
            },
            "unmatched": "error",
            "default": null
          },
          {
            "op": "delete_json_pointer",
            "path": "/output_config/effort"
          },
          {
            "op": "remove_if_empty",
            "path": "/output_config"
          }
        ]
      }
    },
    {
      "profile_id": "opencode-go.anthropic.budget.v1",
      "description": "OpenCode v2 generic Anthropic budget variants below its output ceiling",
      "payload": {
        "profile_id": "opencode-go.anthropic.budget.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "high": {
                "type": "enabled",
                "budget_tokens": 16000
              },
              "max": {
                "type": "enabled",
                "budget_tokens": 31999
              }
            },
            "unmatched": "error",
            "default": null
          },
          {
            "op": "delete_json_pointer",
            "path": "/output_config/effort"
          },
          {
            "op": "remove_if_empty",
            "path": "/output_config"
          },
          {
            "op": "fit_thinking_budget",
            "path": "/thinking/budget_tokens",
            "limit_path": "/max_tokens",
            "minimum": 1024
          }
        ]
      }
    }
  ],
