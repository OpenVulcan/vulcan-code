  "usage_profiles": [],
  "request_profiles": [
    {
      "profile_id": "open-design.explicit-reasoning.v1",
      "description": "Preserve the exact user-selected gateway effort, including explicit none, after protocol conversion.",
      "payload": {
        "profile_id": "open-design.explicit-reasoning.v1",
        "revision": 1,
        "steps": [
          {
            "op": "copy_request_field",
            "path": "/reasoning_effort",
            "field": "reasoning_effort"
          }
        ]
      }
    },
    {
      "profile_id": "open-design.anthropic.adaptive-effort.v1",
      "description": "Map the selected effort to Anthropic adaptive thinking and output_config.effort; none disables thinking.",
      "payload": {
        "profile_id": "open-design.anthropic.adaptive-effort.v1",
        "revision": 1,
        "steps": [
          {
            "op": "enum_map",
            "path": "/thinking",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "mapping": {
              "none": {
                "type": "disabled"
              },
              "low": {
                "type": "adaptive",
                "display": "summarized"
              },
              "medium": {
                "type": "adaptive",
                "display": "summarized"
              },
              "high": {
                "type": "adaptive",
                "display": "summarized"
              },
              "xhigh": {
                "type": "adaptive",
                "display": "summarized"
              },
              "max": {
                "type": "adaptive",
                "display": "summarized"
              }
            },
            "unmatched": "error",
            "default": null
          },
          {
            "op": "copy_request_field",
            "path": "/output_config/effort",
            "field": "reasoning_effort"
          },
          {
            "op": "delete_if_equals",
            "path": "/output_config/effort",
            "source": "request_field",
            "source_path": "@reasoning_effort",
            "equals": "none"
          },
          {
            "op": "remove_if_empty",
            "path": "/output_config"
          }
        ]
      }
    }
  ],
