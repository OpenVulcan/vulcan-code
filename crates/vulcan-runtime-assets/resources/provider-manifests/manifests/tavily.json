    {
      "target_id": "public-api.search",
      "description": "Search the public web with the selected Tavily account and return provider-backed structured results.",
      "service_entry_id": "public-api",
      "credential_profile_ids": [
        "api-key"
      ],
      "upstream_target_id": "search",
      "display_name": "Tavily Search",
      "tool_id": "vulcan_web_search",
      "capability": "web_search",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Tavily structured web search arguments.",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "The exact web search query."
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "Maximum number of ordered results."
          },
          "include_domains": {
            "type": "array",
            "maxItems": 300,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional exact domain allowlist."
          },
          "exclude_domains": {
            "type": "array",
            "maxItems": 150,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional exact domain blocklist."
          }
        },
        "required": [
          "query"
        ]
      },
      "output": {
        "kind": "search",
        "source_path": "/results",
        "normalized_result_path": "search",
        "resource_kind": null,
        "mime_types": []
      },
      "execution": {
        "endpoint_path": "/search",
        "authentication": "bearer_authorization",
        "adapter": "generic_json",
        "execution_kind": "http_json_sync"
      }
    },
    {
      "target_id": "public-api.extract",
      "description": "Extract structured content from one or more HTTPS pages with the selected Tavily account.",
      "service_entry_id": "public-api",
      "credential_profile_ids": [
        "api-key"
      ],
      "upstream_target_id": "extract",
      "display_name": "Tavily Extract",
      "tool_id": "vulcan_web_extract",
      "capability": "web_extract",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Tavily web extraction arguments.",
        "additionalProperties": false,
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "description": "One to twenty credential-free HTTPS URLs."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Optional query used to retain relevance-ranked chunks."
          },
          "chunks_per_source": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Relevant chunks per source; valid only when query is present."
          },
          "extract_depth": {
            "type": "string",
            "enum": [
              "basic",
              "advanced"
            ],
            "default": "basic",
            "description": "Provider extraction depth."
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "text"
            ],
            "default": "markdown",
            "description": "Extracted content format."
          },
          "include_images": {
            "type": "boolean",
            "default": false,
            "description": "Request extracted image URLs."
          },
          "include_favicon": {
            "type": "boolean",
            "default": false,
            "description": "Request each page favicon URL."
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "description": "Provider extraction timeout in seconds."
          }
        },
        "required": [
          "urls"
        ],
        "dependentRequired": {
          "chunks_per_source": [
            "query"
          ]
        }
      },
