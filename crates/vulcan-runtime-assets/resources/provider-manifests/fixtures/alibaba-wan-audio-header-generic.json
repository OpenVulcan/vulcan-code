    "service_entry_id": "model-studio-cn",
    "credential_profile_ids": ["api-key"],
    "upstream_target_id": "wan2.7-t2v",
    "display_name": "Alibaba Wan Audio Header Fixture",
    "tool_id": "fixture_alibaba_wan_audio_header_generic",
    "capability": "video_generate",
    "input_schema": {
