      "method": "GET",
      "path": "/api/v1/tasks/task-audio",
      "response_status": 200,
      "response_json_body": {
        "request_id": "request-poll",
        "code": "",
        "output": {
          "task_id": "task-audio",
          "task_status": "SUCCEEDED",
          "video_url": "https://example.com/audio-driven.mp4"
        }
      }
    }
  ],
  "expected_output_kind": "resources"
}
