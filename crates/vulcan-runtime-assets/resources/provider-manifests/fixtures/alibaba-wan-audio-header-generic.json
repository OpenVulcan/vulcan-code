  "required_execution_primitives": ["http_json_async_poll"],
  "required_upload_primitives": ["remote_url_passthrough"],
  "arguments": {
    "prompt": "animate to music",
    "audio_path": "https://example.com/music.mp3"
  },
  "interactions": [
    {
      "method": "POST",
      "path": "/api/v1/services/aigc/video-generation/video-synthesis",
      "expected_headers": {
        "x-dashscope-async": "enable",
        "x-dashscope-ossresource-resolve": "enable"
      },
      "expected_json_body": {
