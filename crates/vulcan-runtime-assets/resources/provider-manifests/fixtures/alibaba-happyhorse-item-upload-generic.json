            "required": ["kind", "path"]
          }
        }
      },
      "required": ["prompt", "references"]
    },
    "output": {
      "kind": "resources",
      "source_path": "/output/video_url",
      "normalized_result_path": "resources",
      "resource_kind": "video",
      "mime_types": ["video/mp4"],
      "resource_decoders": [
        {
          "source_path": "/output/video_url",
          "encoding": "public_http_url",
          "resource_kind": "video",
          "mime_type": "video/mp4",
          "optional": false,
          "output_id_prefix": "video"
        }
      ]
    },
    "execution": {
      "endpoint_path": "/api/v1/services/aigc/video-generation/video-synthesis",
