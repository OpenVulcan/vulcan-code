      "adapter": "generic_json",
      "execution_kind": "http_json_async_poll",
      "start_fixed_headers": {"x-dashscope-async": "enable"},
      "start_conditional_headers": [
        {
          "name": "x-dashscope-ossresource-resolve",
          "value": "enable",
          "when_any": [
            {"pointer_pattern": "/references/*/kind", "equals": "video"},
            {"pointer_pattern": "/references/*/voice"}
          ]
        }
      ]
    }
  },
  "operation": {
    "operation_id": "fixture.alibaba-happyhorse-item-upload-generic",
    "operation": "video_generate",
    "carrier": "provider_tool",
    "input_resources": ["image", "video", "audio"],
    "output_resources": ["video"],
    "tool_target_refs": ["model-studio-cn.fixture-happyhorse-item-upload-generic"],
    "request_profile_refs": ["alibaba.async.happyhorse-generate.request.v1"],
    "response_profile_refs": ["alibaba.async.task.response.v1"],
    "upload_channel_refs": [
      "fixture.remote-image",
      "fixture.remote-video",
      "fixture.remote-audio"
    ],
    "upload_bindings": [
      {
        "source_path": "/references",
        "target_path": "/references",
        "item_source_path": "/path",
        "item_target_path": "/carrier",
        "item_match_path": "/kind",
        "item_match_value": "image",
        "upload_channel_refs": ["fixture.remote-image"],
        "mime_types_by_extension": {"png": "image/png"},
        "required": true,
        "remove_source": true
      },
      {
        "source_path": "/references",
        "target_path": "/references",
        "item_source_path": "/path",
        "item_target_path": "/carrier",
        "item_match_path": "/kind",
        "item_match_value": "video",
        "upload_channel_refs": ["fixture.remote-video"],
        "mime_types_by_extension": {"mp4": "video/mp4"},
        "required": true,
        "remove_source": true
      },
      {
        "source_path": "/references",
        "target_path": "/references",
        "item_source_path": "/voice_path",
        "item_target_path": "/voice",
        "upload_channel_refs": ["fixture.remote-audio"],
        "mime_types_by_extension": {"mp3": "audio/mpeg"},
        "required": false,
        "remove_source": true
      }
    ],
    "async_execution": {
      "poll_interval_ms": 250,
      "max_backoff_ms": 1000,
      "timeout_ms": 2000,
      "cancellation_supported": false,
      "generic_json": {
        "poll_endpoint_path": "/api/v1/tasks",
        "poll_method": "get",
        "task_id_pointer": "/output/task_id",
        "task_id_in_path": true,
        "start_status_pointer": "/output/task_status",
        "start_success_statuses": ["PENDING"],
        "poll_task_id_pointer": "/output/task_id",
        "status_pointer": "/output/task_status",
        "queued_statuses": ["PENDING"],
        "running_statuses": ["RUNNING"],
        "success_statuses": ["SUCCEEDED"],
        "failure_statuses": ["FAILED", "UNKNOWN"],
        "cancelled_statuses": ["CANCELED"],
        "start_requirements": {
          "non_empty_string_pointers": ["/request_id"],
          "empty_or_missing_string_pointers": ["/code"]
        },
        "poll_requirements": {"non_empty_string_pointers": ["/request_id"]},
        "poll_success_requirements": {
          "empty_or_missing_string_pointers": ["/code"]
        }
      }
    },
    "timeout_ms": 2000,
    "idempotent": false
  },
  "upload_channels": [
