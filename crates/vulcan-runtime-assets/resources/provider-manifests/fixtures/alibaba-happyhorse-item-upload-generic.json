      "primitive": "remote_url_passthrough",
      "accepted_mime_types": ["video/mp4"],
      "max_count": 9,
      "progress_supported": false,
      "cancellation_supported": false,
      "reference_encoding": "response_url"
    },
    {
      "upload_channel_id": "fixture.remote-audio",
      "description": "Fixture-only reviewed remote audio passthrough.",
      "primitive": "remote_url_passthrough",
      "accepted_mime_types": ["audio/mpeg"],
      "max_count": 9,
      "progress_supported": false,
      "cancellation_supported": false,
      "reference_encoding": "response_url"
