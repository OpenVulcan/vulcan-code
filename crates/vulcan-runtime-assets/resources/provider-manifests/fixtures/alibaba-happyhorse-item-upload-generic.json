          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string", "enum": ["image", "video"]},
              "path": {"type": "string", "minLength": 1},
              "voice_path": {"type": "string", "minLength": 1}
