    "description": "Generic HappyHorse item-scoped upload mapping fixture.",
    "service_entry_id": "model-studio-cn",
    "credential_profile_ids": ["api-key"],
    "upstream_target_id": "happyhorse-1.1-r2v",
    "display_name": "Alibaba HappyHorse Item Upload Fixture",
    "tool_id": "fixture_alibaba_happyhorse_item_upload_generic",
    "capability": "video_generate",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
