{
  "schema_version": "provider-manifest-execution-fixture.v1",
  "fixture_id": "alibaba-fun-asr-batch-generic",
  "base_manifest": "alibaba.json",
  "production_target_refs": [
    "alibaba::model-studio-cn.fun-asr.speech-transcribe"
  ],
  "tool_target": {
    "target_id": "model-studio-cn.fixture-fun-asr-batch-generic",
    "description": "Generic Fun-ASR ordered batch transcription fixture.",
    "service_entry_id": "model-studio-cn",
    "credential_profile_ids": ["api-key"],
    "upstream_target_id": "fun-asr",
    "display_name": "Alibaba Fun-ASR Batch Fixture",
    "tool_id": "fixture_alibaba_fun_asr_batch_generic",
    "capability": "speech_transcribe",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": ["source_paths"]
    },
    "output": {
      "kind": "text",
      "source_path": "output.results[].transcription_url",
      "normalized_result_path": "text"
    },
    "execution": {
      "endpoint_path": "/api/v1/services/audio/asr/transcription",
      "authentication": "bearer_authorization",
      "adapter": "generic_json",
      "execution_kind": "http_json_async_poll",
      "start_fixed_headers": {
        "x-dashscope-async": "enable",
        "x-dashscope-ossresource-resolve": "enable"
      }
    }
  },
  "operation": {
    "operation_id": "fixture.alibaba-fun-asr-batch-generic",
    "operation": "speech_transcribe",
    "carrier": "provider_tool",
    "input_resources": ["audio", "video"],
    "output_resources": [],
    "tool_target_refs": ["model-studio-cn.fixture-fun-asr-batch-generic"],
    "request_profile_refs": ["alibaba.async.fun-asr.request.v1"],
    "response_profile_refs": ["alibaba.async.task.response.v1"],
    "upload_channel_refs": ["fixture.remote-media"],
    "upload_bindings": [
      {
        "source_path": "/source_paths",
        "target_path": "/sources",
        "upload_channel_refs": ["fixture.remote-media"],
        "mime_types_by_extension": {
          "mp3": "audio/mpeg",
          "wav": "audio/wav",
          "mp4": "video/mp4"
        },
        "required": true,
        "remove_source": true
      }
    ],
    "async_execution": {
      "poll_interval_ms": 250,
      "max_backoff_ms": 1000,
      "timeout_ms": 3000,
      "cancellation_supported": false,
      "generic_json": {
        "poll_endpoint_path": "/api/v1/tasks",
        "poll_method": "get",
        "task_id_pointer": "/output/task_id",
        "task_id_in_path": true,
        "start_status_pointer": "/output/task_status",
        "start_success_statuses": ["PENDING"],
        "poll_task_id_pointer": "/output/task_id",
        "status_pointer": "/output/task_status",
        "queued_statuses": ["PENDING"],
        "running_statuses": ["RUNNING"],
        "success_statuses": ["SUCCEEDED"],
        "failure_statuses": ["FAILED", "UNKNOWN"],
        "cancelled_statuses": ["CANCELED"],
        "start_requirements": {
          "non_empty_string_pointers": ["/request_id"],
          "empty_or_missing_string_pointers": ["/code"]
        },
        "poll_requirements": {"non_empty_string_pointers": ["/request_id"]},
        "poll_success_requirements": {
          "empty_or_missing_string_pointers": ["/code"]
        },
        "recovery_identity_source_pointer": "/sources",
        "success_batch_follow_up": {
          "items_pointer": "/output/results",
          "item_identity_pointer": "/file_url",
          "item_status_pointer": "/subtask_status",
          "item_success_statuses": ["SUCCEEDED"],
          "item_url_pointer": "/transcription_url",
          "url_encoding": "public_http_url",
          "url_host_suffixes": ["127.0.0.1"],
          "response_items_pointer": "/transcripts",
          "response_text_pointer": "/text",
          "response_item_separator": "\n",
          "result_separator": "\n\n",
          "max_items": 100
        }
      }
    },
    "timeout_ms": 3000,
    "idempotent": false
  },
  "upload_channels": [
    {
      "upload_channel_id": "fixture.remote-media",
      "description": "Fixture-only reviewed remote media passthrough.",
      "primitive": "remote_url_passthrough",
      "remote_url_host_suffixes": ["example.com"],
      "accepted_mime_types": ["audio/mpeg", "audio/wav", "video/mp4"],
      "max_count": 100,
      "progress_supported": false,
      "cancellation_supported": false,
      "reference_encoding": "response_url"
    }
  ],
  "required_execution_primitives": ["http_json_async_poll"],
  "required_upload_primitives": ["remote_url_passthrough"],
  "arguments": {
    "source_paths": [
      "https://example.com/a.mp3",
      "https://example.com/b.mp3"
    ]
  },
  "interactions": [
    {
      "method": "POST",
      "path": "/api/v1/services/audio/asr/transcription",
      "expected_headers": {
        "x-dashscope-async": "enable",
        "x-dashscope-ossresource-resolve": "enable"
      },
      "expected_json_body": {
        "model": "fun-asr",
        "input": {
          "file_urls": [
            "https://example.com/a.mp3",
            "https://example.com/b.mp3"
          ]
        },
        "parameters": {"channel_id": [0]}
      },
      "response_status": 200,
      "response_json_body": {
        "request_id": "request-start",
        "code": "",
        "output": {"task_id": "task-batch", "task_status": "PENDING"}
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/tasks/task-batch",
      "response_status": 200,
      "response_json_body": {
        "request_id": "request-poll",
        "code": "",
        "output": {
          "task_id": "task-batch",
          "task_status": "SUCCEEDED",
          "results": [
            {
              "file_url": "https://example.com/b.mp3",
              "subtask_status": "SUCCEEDED",
              "transcription_url": "{fixture_base_url}/transcript-b"
            },
            {
              "file_url": "https://example.com/a.mp3",
              "subtask_status": "SUCCEEDED",
              "transcription_url": "{fixture_base_url}/transcript-a"
            }
          ]
        }
      }
    },
    {
      "method": "GET",
      "path": "/transcript-a",
      "response_status": 200,
      "response_json_body": {
        "transcripts": [{"text": "A1"}, {"text": "A2"}]
      }
    },
    {
      "method": "GET",
      "path": "/transcript-b",
      "response_status": 200,
      "response_json_body": {"transcripts": [{"text": "B1"}]}
    }
  ],
  "expected_output_kind": "text",
  "expected_text_output": "A1\nA2\n\nB1"
}
