{
  "id": "deepseek",
  "name": "DeepSeek",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "DEEPSEEK_API_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "usageCapture": {
    "openaiCompatibleStreaming": {
      "requestIncludeUsage": true,
      "responseSources": [
        "top-level-empty-choices-chunk",
        "top-level-terminal-chunk"
      ]
    }
  },
  "reasoningProfile": {
    "kind": "tiered",
    "off": {
      "thinking": {
        "type": "disabled"
      }
    },
    "high": {
      "thinking": {
        "type": "enabled"
      },
      "reasoning_effort": "high"
    },
    "xHigh": {
      "thinking": {
        "type": "enabled"
      },
      "reasoning_effort": "max"
    },
    "highLabel": "高",
    "xHighLabel": "Max"
  },
  "baseUrl": {
    "kind": "fixed",
    "value": "https:\/\/api.deepseek.com",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "openai-models"
  },
  "models": [
    {
      "id": "deepseek-chat",
      "name": "DeepSeek Chat",
      "family": "deepseek",
      "releaseDate": "2025-12-01",
      "contextLimit": 1000000,
      "outputLimit": 384000,
      "reasoning": false,
      "toolCall": true,
      "temperature": true,
      "attachment": true,
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "deepseek-reasoner",
      "name": "DeepSeek Reasoner",
      "family": "deepseek-thinking",
      "releaseDate": "2025-12-01",
      "contextLimit": 1000000,
      "outputLimit": 384000,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": true,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "deepseek-v4-flash",
      "name": "DeepSeek V4 Flash",
      "family": "deepseek-flash",
      "releaseDate": "2026-04-24",
      "contextLimit": 1000000,
      "outputLimit": 384000,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "deepseek-v4-pro",
      "name": "DeepSeek V4 Pro",
      "family": "deepseek-thinking",
      "releaseDate": "2026-04-24",
      "contextLimit": 1000000,
      "outputLimit": 384000,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    }
  ]
}
