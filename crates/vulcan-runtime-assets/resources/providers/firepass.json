{
  "id": "firepass",
  "name": "Fireworks (Firepass)",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "FIREPASS_API_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "baseUrl": {
    "kind": "fixed",
    "value": "https://api.fireworks.ai/inference/v1",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "openai-models"
  },
  "models": [
    {
      "id": "accounts/fireworks/routers/kimi-k2p6-turbo",
      "name": "Kimi K2.6 Turbo",
      "family": "kimi-thinking",
      "releaseDate": "2026-04-17",
      "contextLimit": 262000,
      "outputLimit": 262000,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text",
        "image"
      ],
      "outputModalities": [
        "text"
      ]
    }
  ]
}
