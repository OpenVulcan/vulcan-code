{
  "name": "vulcan-code-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:file-icons": "node scripts/generate-file-icon-collection.mjs",
    "prebuild": "pnpm run generate:file-icons",
    "build": "tsc -b && vite build",
    "check:build-budget": "node scripts/check-build-budget.mjs",
    "check:ui-architecture": "node scripts/check-ui-architecture.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:architecture": "node --test scripts/check-build-budget.test.mjs scripts/check-ui-architecture.test.mjs",
    "test:build-budget": "node --test scripts/check-build-budget.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@iconify-json/material-icon-theme": "^1.2.67",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "0.577.0",
    "mermaid": "11.16.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "4.1.10"
  }
}
