{
  "name": "vulcan-code-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:file-icons": "node scripts/generate-file-icon-collection.mjs",
    "prebuild": "pnpm run generate:file-icons",
    "build": "pnpm run lint && pnpm run typecheck && pnpm run check:ui-architecture && vite build && pnpm run check:build-budget",
    "check:build-budget": "node scripts/check-build-budget.mjs",
    "check:ui-architecture": "node scripts/check-ui-architecture.mjs",
    "report:unused-css": "node scripts/report-unused-css.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test:lint": "node --test scripts/check-lint.test.mjs",
    "test": "vitest run",
    "test:architecture": "node --test scripts/check-build-budget.test.mjs scripts/check-ui-architecture.test.mjs scripts/report-unused-css.test.mjs",
    "test:build-budget": "node --test scripts/check-build-budget.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@iconify-json/material-icon-theme": "^1.2.67",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dagre-d3-es": "7.0.14",
    "katex": "0.16.47",
    "lucide-react": "0.577.0",
    "mermaid": "11.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "10.11.0",
    "js-yaml": "4.3.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "4.1.10"
  }
}
