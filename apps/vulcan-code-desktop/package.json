{
  "name": "vulcan-code-desktop",
  "productName": "Vulcan Code Desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop client and Core browser host for Vulcan Code.",
  "main": "dist/desktop-entry.js",
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && node tools/copy-i18n-catalogs.mjs",
    "start": "electron dist/gui/main.js",
    "test:unit": "node --test dist/**/*.test.js",
    "test:workbench-history": "node tools/test-workbench-history.mjs",
    "test:integration": "node tools/test-integration.mjs",
    "w02:compatibility": "node tools/w02-compatibility.mjs",
    "w05:acceptance": "node tools/w05-gui-acceptance.mjs"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "^25.9.1",
    "@types/ws": "8.18.1",
    "electron": "44.4.1",
    "playwright-core": "1.64.0-alpha-1789764292000",
    "rcedit": "5.0.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "parse5": "8.0.1",
    "ws": "8.21.3"
  }
}
