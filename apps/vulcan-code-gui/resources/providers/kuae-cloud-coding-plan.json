{
  "id": "kuae-cloud-coding-plan",
  "name": "KUAE Cloud Coding Plan",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "KUAE_API_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "baseUrl": {
    "kind": "fixed",
    "value": "https:\/\/coding-plan-endpoint.kuaecloud.net\/v1",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "none"
  },
  "models": [
    {
      "id": "GLM-4.7",
      "name": "GLM-4.7",
      "family": "glm",
      "releaseDate": "2025-12-22",
      "contextLimit": 204800,
      "outputLimit": 131072,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ],
      "defaultEnabled": true
    }
  ]
}
