{
  "id": "abliteration-ai",
  "name": "abliteration.ai",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "ABLIT_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "baseUrl": {
    "kind": "fixed",
    "value": "https:\/\/api.abliteration.ai\/v1",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "openai-models"
  },
  "models": [
    {
      "id": "abliterated-model",
      "name": "Abliterated Model",
      "releaseDate": "2026-01-06",
      "contextLimit": 150000,
      "inputLimit": 150000,
      "outputLimit": 8192,
      "reasoning": false,
      "toolCall": true,
      "temperature": true,
      "attachment": true,
      "inputModalities": [
        "text",
        "image"
      ],
      "outputModalities": [
        "text"
      ]
    }
  ]
}
