{
  "id": "xpersona",
  "name": "Xpersona",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "XPERSONA_API_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "baseUrl": {
    "kind": "fixed",
    "value": "https://www.xpersona.co/v1",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "openai-models"
  },
  "models": [
    {
      "id": "xpersona-frieren-coder",
      "name": "Xpersona Frieren Coder",
      "releaseDate": "2026-05-01",
      "contextLimit": 400000,
      "outputLimit": 128000,
      "reasoning": true,
      "toolCall": true,
      "temperature": false,
      "attachment": false,
      "inputModalities": [
        "text",
        "image"
      ],
      "outputModalities": [
        "text"
      ]
    }
  ]
}
