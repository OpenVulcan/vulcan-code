{
  "id": "hpc-ai",
  "name": "HPC-AI",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "HPC_AI_API_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "baseUrl": {
    "kind": "fixed",
    "value": "https:\/\/api.hpc-ai.com\/inference\/v1",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "openai-models"
  },
  "models": [
    {
      "id": "minimax\/minimax-m2.5",
      "name": "MiniMax M2.5",
      "family": "minimax-m2.5",
      "releaseDate": "2026-02-12",
      "contextLimit": 1000000,
      "outputLimit": 131072,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "moonshotai\/kimi-k2.5",
      "name": "Kimi K2.5",
      "family": "kimi",
      "releaseDate": "2026-01-01",
      "contextLimit": 262144,
      "outputLimit": 262144,
      "reasoning": true,
      "toolCall": true,
      "temperature": false,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text",
        "image",
        "video"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "zai-org\/glm-5.1",
      "name": "GLM 5.1",
      "family": "glm",
      "releaseDate": "2026-04-08",
      "contextLimit": 202000,
      "outputLimit": 202000,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    }
  ]
}
