{
  "id": "drun",
  "name": "D.Run (China)",
  "runtime": "openai-compatible",
  "credentialEnvKeys": [
    "DRUN_API_KEY"
  ],
  "fields": [
    "apiKey"
  ],
  "baseUrl": {
    "kind": "fixed",
    "value": "https:\/\/chat.d.run\/v1",
    "allowOverride": false
  },
  "modelDiscovery": {
    "kind": "openai-models"
  },
  "models": [
    {
      "id": "public\/deepseek-r1",
      "name": "DeepSeek R1",
      "family": "deepseek-thinking",
      "releaseDate": "2025-01-20",
      "contextLimit": 131072,
      "outputLimit": 32000,
      "reasoning": true,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "interleaved": {
        "field": "reasoning_content"
      },
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "public\/deepseek-v3",
      "name": "DeepSeek V3",
