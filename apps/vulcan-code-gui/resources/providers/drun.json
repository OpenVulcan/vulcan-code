      "reasoning": false,
      "toolCall": true,
      "temperature": true,
      "attachment": false,
      "inputModalities": [
        "text"
      ],
      "outputModalities": [
        "text"
      ]
    },
    {
      "id": "public\/minimax-m25",
      "name": "MiniMax M2.5",
      "family": "minimax",
      "releaseDate": "2025-03-01",
      "contextLimit": 204800,
