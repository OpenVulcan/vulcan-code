{
  "schemaVersion": 1,
  "vmPool": {
    "minSize": 4,
    "maxSize": 8,
    "idleTtlSecs": 60
  },
  "runLuaPool": {
    "minSize": 1,
    "maxSize": 4,
    "idleTtlSecs": 30
  },
  "toolCache": {
    "maxEntries": 1000,
    "defaultTtlSecs": 1800,
    "maxTtlSecs": 1800
  },
  "network": {
    "allowDownloads": true,
    "githubBaseUrl": null,
    "githubApiBaseUrl": null,
    "officialSkillHubBaseUrl": null,
    "enablePrivateUrlSkillInstall": false,
    "privateSkillSourceAllowlist": [],
    "customGithubMirrors": [],
    "dismissedHubRegionPrompts": []
  },
  "capabilities": {
    "defaultTextEncoding": null,
    "enableSkillManagementBridge": false,
    "enableManagedIoCompat": true
  },
  "managedRuntime": {
    "workerPoolMaxSizePerEnvironment": 4,
    "workerIdleTtlSecs": 60,
    "persistentSessionLimitPerEngine": 256,
    "persistentSessionDefaultBufferLimitBytesPerStream": 1048576,
    "invokeDefaultTimeoutMs": 60000
  },
  "aiTools": {
    "enableRunLua": true,
    "enableRunLuaSession": true
  }
